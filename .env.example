# Copy to .env and fill in. Never commit .env.
#
# Host ports are deliberately non-standard (55xxx) so this stack does not
# collide with other local Postgres/Redis instances.

# --- Runtime ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Postgres (consumed by docker-compose) ---
POSTGRES_DB=tws_ecommerce
POSTGRES_USER=tws
POSTGRES_PASSWORD=tws_dev_password
POSTGRES_PORT=55432

# --- Redis / API host ports (consumed by docker-compose) ---
REDIS_PORT=56379
API_PORT=58000

# --- Application datastore URLs ---
# Use localhost ports when running the API on the host; docker-compose overrides
# these with in-network hostnames for the containerised API.
DATABASE_URL=postgresql+asyncpg://tws:tws_dev_password@localhost:55432/tws_ecommerce
REDIS_URL=redis://localhost:56379/0

# Separate database used by the test suite. It is created/dropped by the tests.
TEST_DATABASE_URL=postgresql+asyncpg://tws:tws_dev_password@localhost:55432/tws_ecommerce_test

# --- Connection pool ---
# Per worker process. Keep (DB_POOL_SIZE + DB_MAX_OVERFLOW) * workers well below
# the Postgres max_connections limit, or put PgBouncer in front.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# --- Authentication ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The two secrets MUST differ and must be >= 32 chars outside development.
JWT_SECRET=replace-me-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-refresh-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- HTTP ---
# Comma-separated browser origins allowed to call the API. Empty means none.
# A wildcard is refused outright in production.
CORS_ORIGINS=http://localhost:3000

# Interactive API docs (/docs, /redoc, /openapi.json). Leave unset for
# "enabled outside production"; set true/false to force it either way.
# DOCS_ENABLED=false

# Trusted reverse proxy / load balancer address. Uvicorn rewrites the client IP
# from X-Forwarded-For ONLY for peers listed here, so the header cannot be used
# to rotate past the per-IP login limit. Leave unset when not behind a proxy;
# set it to the load balancer's address on deploy, or every request will share
# a single rate-limit bucket.
# FORWARDED_ALLOW_IPS=10.0.0.1

# --- Rate limiting ---
# Two budgets guard login: per-account stops one account being brute-forced,
# per-IP stops one source spraying a password across many accounts.
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_IP_RATE_LIMIT_ATTEMPTS=30
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# --- Database timeouts ---
# How long a request waits for a free pooled connection before failing.
DB_POOL_TIMEOUT_SECONDS=10
# Server-side cap on any single statement, so a runaway query cannot hold a
# pooled connection open indefinitely.
DB_STATEMENT_TIMEOUT_SECONDS=15

# --- Seed data (app.commands.seed) ---
SEED_TENANT_NAME=Zeen
SEED_TENANT_SLUG=zeen
SEED_ADMIN_EMAIL=admin@zeen.com
SEED_ADMIN_PASSWORD=replace-me

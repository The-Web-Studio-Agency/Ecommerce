# Origin of the Zeen API, including the /api/v1 prefix.
#
# The backend resolves which tenant a request belongs to from the Host
# header of this URL -- there is no tenant header or parameter. In
# development, a loopback host falls back to the seeded tenant. In
# production this must be a domain registered in the backend's
# tenant_domains table, and the backend's CORS_ORIGINS must list the
# storefront's own origin.
NEXT_PUBLIC_API_URL=http://localhost:58000/api/v1

# Currency for catalogue prices. Orders and coupons carry their own, which
# always wins; this only covers the storefront, where the backend exposes no
# currency of its own. ISO 4217, and it must match the tenant's currency.
NEXT_PUBLIC_CURRENCY=INR

# Public origin of the storefront, used for canonical URLs, the sitemap and
# Open Graph. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MSG91 OTP widget, which is how customers sign in. The widget collects the
# number and checks the code in the browser, then hands back a token the API
# confirms with MSG91 -- so these two are safe to expose, but the account
# auth key is not and belongs in the backend's MSG91_AUTH_KEY.
#
# Both come from the widget's page in the MSG91 console. Without them
# /signin renders a "not configured" notice instead of a form that cannot
# work.
NEXT_PUBLIC_MSG91_WIDGET_ID=
NEXT_PUBLIC_MSG91_TOKEN_AUTH=
